{
  "manifest_version": 3,
  "name": "YTF - YouTube Friends",
  "version": "1.0.0",
  "description": "Seamless YouTube Social — Watch together, chat, and sync videos with friends.",
  "key": "",

  "permissions": [
    "identity",
    "storage",
    "alarms",
    "tabs"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "https://hpserverdebian.tail4eb463.ts.net/*",
    "https://discord.com/*",
    "https://discordapp.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],

  "action": {
    "default_title": "Toggle YTF Sidebar"
  }
}